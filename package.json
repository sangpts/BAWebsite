{
  "name": "phung-tan-sang-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check:css": "node scripts/check-css-contract.mjs",
    "dev": "next dev",
    "lint": "biome check src",
    "start": "next start",
    "db:start": "docker compose up -d mongodb",
    "db:stop": "docker compose stop mongodb",
    "db:logs": "docker compose logs -f mongodb",
    "db:seed": "node --env-file=.env.local scripts/seed-content.mts",
    "test": "tsc --noEmit",
    "validate": "npm run check:css && npm run test && npm run lint && npm run build"
  },
  "dependencies": {
    "@lobehub/icons": "^5.16.0",
    "lucide-react": "^0.454.0",
    "mongodb": "^7.5.0",
    "next": "^16.2.4",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "typescript": "^5"
  }
}
